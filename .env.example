# Copy to .env and fill in what you have. Everything here is optional: with an
# empty file the pipeline still runs, using the free no-key signals and the
# offline synthesizer, and writes to ./out instead of Supabase. That is the
# mode Phase 0 runs in.

# --- mood synthesis -------------------------------------------------------
# Without a key the four dimensions are computed arithmetically and the title
# comes from a seeded word bank. With one, Claude adjusts the numbers within a
# bounded range and writes the themes and the title.
ANTHROPIC_API_KEY=
DF_SYNTHESIS_MODEL=claude-haiku-4-5-20251001

# --- signals --------------------------------------------------------------
# GDELT, CoinGecko, NOAA, USGS and the moon need no key.
# Weather does, and its history is a paid plan — backfilled days go without it.
OPENWEATHER_API_KEY=
# One of: reykjavik, london, sao-paulo, new-york, tokyo, lagos.
# Until regions arrive in phase 4 this is the single location.
DF_WEATHER_PLACE=reykjavik
# CoinGecko's free tier works unauthenticated; a demo key raises the rate limit.
COINGECKO_API_KEY=
# GDELT allows one request every five seconds and refuses politely if you
# ignore it. Raise this if you are sharing an egress IP.
GDELT_MIN_INTERVAL_MS=6000

# --- storage --------------------------------------------------------------
# Leave blank to keep everything in ./out.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- the site -------------------------------------------------------------
# web/ reads these; without them it falls back to ./out/emissions/index.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- rendering ------------------------------------------------------------
# Chromium is found automatically (Playwright's download, then PATH). Set this
# to point at a specific binary.
PUPPETEER_EXECUTABLE_PATH=
# ffmpeg is found on PATH. Without it, tracks stay WAV and the EP cannot be
# assembled.
FFMPEG_PATH=
# Override the mood-driven track length. Handy for a fast variance gate.
DF_TRACK_SECONDS=
